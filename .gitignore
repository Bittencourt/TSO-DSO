# Julia package .gitignore
#
# NOTE (INFRA-01 / RESEARCH Pitfall 3): Manifest.toml is intentionally COMMITTED
# for reproducible clean-checkout resolution. Do NOT add Manifest.toml here.

# Per-run experiment artifacts (JLD2 via DrWatson datadir/tagsave) — binary, non-diffable
# (RESEARCH 08 Pitfall 3). The diff-friendly, committed counterpart is results/ (CSV summaries).
/data/

# Documenter build output
/docs/build/
/docs/site/

# Literate-generated markdown (regenerated from docs/literate/*.jl by docs/make.jl)
/docs/src/generated/

# Coverage artifacts
*.jl.cov
*.jl.*.cov
*.jl.mem
/lcov.info

# Local scratch / editor
*.swp
.DS_Store

# Third-party copyrighted reference material (thesis/paper/PSR PDFs) — kept local, not redistributed
/docs/references/
# CocoIndex Code (ccc)
/.cocoindex_code/

# Knowledge-graph tooling caches (regenerable via /graphify and /gsd:graphify)
/graphify-out/
/.planning/graphs/

# Generated figures (regenerable from scripts/*.jl) — keep results/ for diff-friendly .txt/.csv summaries
/results/**/*.pdf
/results/**/*.png
/results/**/*.svg

# Authored writeups: track the Typst source, ignore the compiled PDF (regenerable via `typst compile`)
/docs/writeups/*.pdf
